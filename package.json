{
  "name": "@kvidzibo/pi-delegate",
  "version": "0.29.1",
  "description": "Delegate coding tasks to Pi workers through the native Pi extension",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "delegate",
    "child-runtime",
    "README.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "author": "Tomas Rackauskas",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvidzibo/pi-delegate.git"
  },
  "homepage": "https://github.com/kvidzibo/pi-delegate#readme",
  "bugs": {
    "url": "https://github.com/kvidzibo/pi-delegate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./delegate"
    ]
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:load",
    "test:unit": "node --test --experimental-strip-types delegate/tests/*.test.ts child-runtime/tests/*.test.ts",
    "test:load": "node --test --experimental-strip-types tests/load.test.ts"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
