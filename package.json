{
  "name": "@kvidzibo/pi-delegate",
  "version": "0.11.2",
  "description": "Pi parent child tool: named agents, model from config",
  "author": "Tomas Rackauskas",
  "keywords": ["pi-package"],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvidzibo/pi-delegate.git"
  },
  "homepage": "https://github.com/kvidzibo/pi-delegate#readme",
  "bugs": {
    "url": "https://github.com/kvidzibo/pi-delegate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": ["./delegate"]
  },
  "files": [
    "delegate/*.ts",
    "delegate/*.json",
    "delegate/*.md",
    "delegate/prompts/*.md",
    "child-runtime/*.ts",
    "child-runtime/*.md"
  ],
  "scripts": {
    "eval:historical": "node --experimental-strip-types bench/evals/cli.ts",
    "check:package": "node scripts/check-package.mjs",
    "test": "npm run test:unit && npm run test:load",
    "test:unit": "node --test --experimental-strip-types delegate/tests/*.test.ts child-runtime/tests/*.test.ts bench/tests/*.test.ts",
    "test:load": "node --test --experimental-strip-types tests/load.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
